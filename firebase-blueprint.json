{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private sanctuary account profile for an authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Full display name from Google profile or user input.",
          "minLength": 1,
          "maxLength": 100
        },
        "preferredName": {
          "type": "string",
          "description": "Optional preferred greeting name inside My World.",
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified account email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "photoUrl": {
          "type": "string",
          "format": "uri",
          "description": "Optional avatar URL from auth provider.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account profile was last updated."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "HealthProfile": {
      "title": "HealthProfile",
      "description": "Personal Health Monitor profile, optional cultural metadata, and weight check-in preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "weightKg": {
          "type": "number",
          "description": "Current weight in kilograms."
        },
        "heightCm": {
          "type": "number",
          "description": "Height in centimeters."
        },
        "dob": {
          "type": "string",
          "format": "date",
          "description": "Date of birth (YYYY-MM-DD).",
          "minLength": 10,
          "maxLength": 10
        },
        "biologicalSex": {
          "type": "string",
          "enum": ["male", "female", "other"]
        },
        "dietPreference": {
          "type": "string",
          "enum": ["veg", "non-veg", "both"]
        },
        "activityLevel": {
          "type": "string",
          "enum": ["sedentary", "light", "moderate", "active"]
        },
        "dailyStepGoal": {
          "type": "number",
          "description": "Daily target step count."
        },
        "targetWeightKg": {
          "type": "number",
          "description": "Optional target weight in kilograms."
        },
        "sunSign": {
          "type": "string",
          "maxLength": 40
        },
        "birthStar": {
          "type": "string",
          "maxLength": 40
        },
        "weightReminderDays": {
          "type": "number",
          "description": "Interval in days between weight recheck reminders (default 30)."
        },
        "lastWeightLoggedAt": {
          "type": "string",
          "format": "date",
          "minLength": 10,
          "maxLength": 10
        },
        "weightHistory": {
          "type": "array",
          "description": "Bounded recent weight check-in entries (max 60)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "weightKg",
        "heightCm",
        "dob",
        "dietPreference",
        "activityLevel",
        "dailyStepGoal",
        "weightReminderDays",
        "lastWeightLoggedAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user account profiles, accessible strictly by the owning authenticated user."
    },
    "/users/{userId}/health/{docId}": {
      "schema": {
        "$ref": "#/entities/HealthProfile"
      },
      "description": "Private Personal Health Monitor profile & history owned strictly by the authenticated user."
    }
  }
}
